<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/snooze_interval_title"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>
        
    <Spinner
        android:id="@+id/spinnerInterval"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:layout_marginBottom="16dp"/>

    <!-- Custom minutes input container (shown when 'Custom' is selected) -->
    <LinearLayout
        android:id="@+id/layoutCustomMinutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enter_minutes"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editCustomMinutes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_dock"
            android:paddingHorizontal="16dp"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:hint="@string/custom_minutes_hint"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/snooze_repeat_title"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>
        
    <Spinner
        android:id="@+id/spinnerRepeats"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
