<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="32dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle"
        android:layout_marginBottom="16dp" />

    <!-- Header Row: Title & Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/textSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:textSize="20sp"
            android:fontFamily="sans-serif-bold"
            android:textColor="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/btnSheetClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_day_toggle"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="?android:attr/textColorPrimary" />

    </RelativeLayout>

    <!-- Optional Search Input -->
    <EditText
        android:id="@+id/editSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_dock"
        android:paddingHorizontal="16dp"
        android:hint="@string/search"
        android:textColorHint="?android:attr/textColorSecondary"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp"
        android:inputType="text"
        android:maxLines="1"
        android:visibility="gone" />

    <!-- Recycler List of Items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSheetItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:overScrollMode="never" />

</LinearLayout>
