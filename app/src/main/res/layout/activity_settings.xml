<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp">

        <!-- Top Header Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp">
            
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_back_chevron"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                app:tint="?android:attr/textColorPrimary" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/settings"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />
        </RelativeLayout>

        <!-- Large Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textSize="34sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="24dp"
            android:layout_marginStart="4dp" />

        <!-- Section 1 Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_appearance_language"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Card 1: Theme and Language Segmented Pills -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <!-- Theme Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_title"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="10dp" />

                <!-- Theme Pills -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/pillThemeBlack"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_button"
                        android:textColor="@color/text_pill_button"
                        android:gravity="center"
                        android:text="@string/theme_black"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/pillThemeWhite"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_button"
                        android:textColor="@color/text_pill_button"
                        android:gravity="center"
                        android:text="@string/theme_white"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutline" android:layout_marginBottom="14dp" />

                <!-- Language Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_title"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="10dp" />

                <!-- Language Pills -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pillLangUa"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_button"
                        android:textColor="@color/text_pill_button"
                        android:gravity="center"
                        android:text="@string/lang_ua"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/pillLangEn"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_button"
                        android:textColor="@color/text_pill_button"
                        android:gravity="center"
                        android:text="@string/lang_en"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/pillLangRu"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_button"
                        android:textColor="@color/text_pill_button"
                        android:gravity="center"
                        android:text="@string/lang_ru"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2 Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_region_alert"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Card 2: Air Alert & Region/District selection rows -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPostpone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/postpone_title"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary"
                    app:useMaterialThemeColors="true" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutline" android:layout_marginVertical="6dp" />

                <!-- Region Row with Chevron -->
                <LinearLayout
                    android:id="@+id/btnRowRegion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/select_region"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/textSelectedRegion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_region"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="24sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutline" android:layout_marginVertical="6dp" />

                <!-- District Row with Chevron -->
                <LinearLayout
                    android:id="@+id/btnRowDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/select_district"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/textSelectedDistrict"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_district"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="24sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Alert Status Pill -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp"
                android:gravity="center_vertical">
                <View
                    android:id="@+id/alertIndicator"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/circle_indicator"
                    android:layout_marginEnd="14dp" />
                <TextView
                    android:id="@+id/textAlertStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Blue Check Alert Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckAlert"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/check_alert"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            app:backgroundTint="?attr/colorPrimary"
            android:layout_marginBottom="16dp"
            app:cornerRadius="24dp"
            style="@style/Widget.Material3.Button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/api_warning"
            android:textSize="12sp"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>
</ScrollView>
