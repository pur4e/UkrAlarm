<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Minimalist Dial Ring (Compact & Centered) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:pathData="M 54,34 A 20,20 0 1,1 53.99,34 Z" />

    <!-- 12, 3, 6, 9 Cardinal Ticks -->
    <!-- 12 o'clock -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M 54,36 L 54,38.5" />

    <!-- 3 o'clock -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M 69.5,54 L 72,54" />

    <!-- 6 o'clock -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M 54,69.5 L 54,72" />

    <!-- 9 o'clock -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M 36,54 L 38.5,54" />

    <!-- Hour Hand (Rounded Pill, ~10:10) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M 54,54 L 45.4,48.0" />

    <!-- Minute Hand (Rounded Pill, ~10:10) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M 54,54 L 66.3,46.3" />

    <!-- Center Pivot Ring (White) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,51.6 A 2.4,2.4 0 1,1 53.99,51.6 Z" />

    <!-- Center Pivot Core (Pure Black Depth) -->
    <path
        android:fillColor="#000000"
        android:pathData="M 54,53.1 A 0.9,0.9 0 1,1 53.99,53.1 Z" />

</vector>
